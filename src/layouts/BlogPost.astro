---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Tag from '../components/Tag.astro';
import { Image } from 'astro:assets';
import '../styles/global.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, location, updatedDate, heroImage, tags } =
    Astro.props;
---

<html lang="en">
    <head>
        <BaseHead title={'Dan Horan - ' + title} description={description} />
    </head>

    <body class="flex flex-col min-h-screen">
        <Header />
        <main class="font-sans mx-5 md:mx-15">
            <div class="flex flex-col sm:flex-row gap-4 mt-20">
                <div
                    class="sm:flex sm:flex-col sm:justify-between sm:flex-[1] min-w-[100px] sm:max-w-[400px] sm:basis-[80px] sm:shrink-0"
                >
                    <ul>
                        <li class="mb-0">
                            <h2
                                class="sm:mb-0 text-xs flex items-center text-gray-500"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 mr-2 text-gray-400"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M8 7V3m8 4V3m-9 8h10m-13 9h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v11a2 2 0 002 2z"
                                    ></path>
                                </svg>
                                <FormattedDate date={pubDate} />
                            </h2>
                        </li>
                        {
                            location ? (
                                <li class="mb-5">
                                    <small class="flex-full text-gray-500 text-xs">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-4 h-4 mr-1 inline-block text-gray-400"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M12 11.5a2 2 0 100-4 2 2 0 000 4zm0 9.5c-4-5-6-7.5-6-10a6 6 0 1112 0c0 2.5-2 5-6 10z"
                                            />
                                        </svg>
                                        {location}
                                    </small>
                                </li>
                            ) : (
                                ''
                            )
                        }
                        {
                            tags && tags.length > 0 ? (
                                <li class="mb-5">
                                    <div class="flex flex-wrap gap-2">
                                        {tags.map((tag) => (
                                            <Tag
                                                tag={tag}
                                                href={`/blog/${tag}`}
                                            />
                                        ))}
                                    </div>
                                </li>
                            ) : (
                                ''
                            )
                        }
                    </ul>
                </div>
                <div class="sm:flex-[3] max-w-xl">
                    <h1 class="text-2xl mb-10">{title}</h1>
                    <div class="prose text-lg text-gray-500">
                        <slot />
                    </div>
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>
