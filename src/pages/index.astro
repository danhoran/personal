---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="mx-15 my-20 mt-auto">
      <h1
        class="font-medium mb-[clamp(2rem,5vw,4rem)] leading-none text-[clamp(4rem,16vw,6.6rem)]"
      >
        Developer.<br /><span class="hidden lg:inline"
          >Engineering
        </span>Leader.
      </h1>
      <hr class="mb-[clamp(2rem,5vw,4rem)]" />
      <div class="flex justify-between items-start flex-wrap gap-8">
        <p class="text-xl max-w-sm">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus nec
          dolor at risus lacinia suscipit.
        </p>
        <ul class="flex flex-wrap gap-3 justify-end max-w-md hidden lg:flex">
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >AI</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Observability</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Performance</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Security</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Support</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Leadership</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Delivery</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Reliability</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >CI/CD</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Scalability</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >System Design</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Culture</span
            >
          </li>
          <li class="m-1">
            <span
              class="px-4 py-2 rounded-full bg-gray-200 text-gray-800 text-sm font-medium"
              >Cloud Architecture</span
            >
          </li>
        </ul>
      </div>
    </main>
  </body>
</html>
