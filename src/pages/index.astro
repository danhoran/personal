---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="mx-15 my-20 mt-auto">
      <h1
        class="font-medium mb-[clamp(2rem,5vw,4rem)] leading-none text-[clamp(4rem,16vw,6.6rem)]"
      >
        Developer.<br /><span class="hidden lg:inline"
          >Engineering
        </span>Leader.
      </h1>
      <hr class="mb-[clamp(2rem,5vw,4rem)]" />
      <p class="text-xl">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus nec
        dolor at risus lacinia suscipit.
      </p>
    </main>
  </body>
</html>
