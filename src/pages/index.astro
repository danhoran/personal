---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="mx-15">
      <h1 class="font-medium mb-15 text-9xl leading-34">
        Developer.<br />Engineering Leader.
      </h1>
      <hr class="mb-15" />
      <p>
        I build high-performing teams and scalable systems with a hands-on,
        people-first approach.
      </p>
      <p>
        I’m a software engineer turned engineering leader with a passion for
        building scalable systems and high-performing teams. I care about clean
        code, thoughtful leadership, and creating products that make a
        difference.
      </p>
      <Footer />
    </main>
  </body>
</html>
