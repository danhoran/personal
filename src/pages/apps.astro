---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Introduction from '../components/Introduction.astro';
import Role from '../components/Role.astro';
import Project from '../components/Project.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={SITE_TITLE + ' - Apps'}
            description={SITE_DESCRIPTION}
        />
    </head>
    <body class="flex flex-col min-h-screen">
        <Header />
        <main class="font-sans mx-5 md:mx-15 my-20 mt-auto">
            <div class="flex flex-col sm:flex-row gap-4 mt-20">
                <div
                    class="sm:flex sm:flex-col sm:justify-between sm:flex-[1] sm:max-w-[400px] sm:basis-[80px] sm:shrink-0"
                >
                    <h1 class="hidden sm:block text-xl">Apps</h1>
                </div>
                <div class="sm:flex-[3] max-w-xl">
                    <h2 class="text-2xl mb-8">Hand-made. Quality.</h2>
                    <p class="text-lg text-gray-500 mb-20">
                        Made by Dan. Completely free, always.
                    </p>
                    <div class="flex items-start gap-4 mb-14">
                        <img
                            class="w-20 h-20 flex-shrink-0 drop-shadow-md"
                            src="/images/apps/prompt/icon.png"
                            alt="Prompt"
                        />
                        <div>
                            <h2 class="text-xl mt-2 mb-2">Scripted</h2>
                            <p class="text-gray-500 mb-2">
                                The missing native MacOS teleprompter
                            </p>
                            <div class="mb-2 mt-6">
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    MacOS
                                </span>
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    Swift
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 mb-14">
                        <img
                            class="w-20 h-20 flex-shrink-0 drop-shadow-md"
                            src="/images/apps/compose/icon.png"
                            alt="Prompt"
                        />
                        <div>
                            <h2 class="text-xl mt-2 mb-2">Compose</h2>
                            <p class="text-gray-500 mb-2">
                                Export MacOS icon files from Icon Composer
                            </p>
                            <div class="mb-2 mt-6">
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    MacOS
                                </span>
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    Swift
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 mb-14">
                        <img
                            class="w-20 h-20 flex-shrink-0 drop-shadow-md"
                            src="/images/apps/fairpay/icon.png"
                            alt="Prompt"
                        />
                        <div>
                            <h2 class="text-xl mt-2 mb-2">Fairpay</h2>
                            <p class="text-gray-500 mb-2">
                                Visualise your salary data. Pay fairly.
                            </p>
                            <div class="mb-2 mt-6">
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    Web
                                </span>
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    Python
                                </span>
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    React
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 mb-14">
                        <img
                            class="w-20 h-20 flex-shrink-0 drop-shadow-md"
                            src="/images/apps/peek/icon.png"
                            alt="Prompt"
                        />
                        <div>
                            <h2 class="text-xl mt-2 mb-2">Peek</h2>
                            <p class="text-gray-500 mb-2">
                                Toggle hidden files from the menu bar.
                            </p>
                            <div class="mb-2 mt-6">
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    MacOS
                                </span>
                                <span
                                    class="md inline-block bg-gray-100 text-gray-700 rounded-full px-2 py-1 text-xs"
                                >
                                    Swift
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <Footer />
    </body>
</html>
