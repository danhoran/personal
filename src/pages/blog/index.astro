---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Tag from '../../components/Tag.astro';
import { Image } from 'astro:assets';
import '../../styles/global.css';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const postsCollection = await getCollection('blog');
const allTags = [...new Set(postsCollection.flatMap(post => post.data.tags || []))].sort();
const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = posts.filter(post => post.data.tags?.includes(tag)).length;
  return acc;
}, {} as Record<string, number>);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE + " - Blog"} description={SITE_DESCRIPTION} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="font-sans mx-5 md:mx-15">
      <div class="flex flex-col sm:flex-row gap-4 mt-20">
        <div
          class="sm:flex sm:flex-col sm:justify-between sm:flex-[1] sm:max-w-[400px] sm:basis-[80px] sm:shrink-0"
        >
          <h1 class="underline sm:no-underline mb-10 sm:mb-0 text-xl">
            Latest post
          </h1>
        </div>
        <div class="sm:flex-[3] max-w-xl">
          <ul>
            <li>
              <a
                href={`/blog/${posts[0].id}/`}
                class="p-5 block md:p-10 mb-5 bg-gray-50 rounded-lg hover:bg-gray-200 transition-colors duration-500"
              >
                <div class="sm:flex sm:items-center sm:justify-between">
                  <h4 class="title text-lg sm:pr-5 md:max-w-[400px]">
                    {posts[0].data.title}
                  </h4>
                  <small
                    class="date flex-full text-gray-500 flex items-center shrink-0"
                  >
                    <FormattedDate date={posts[0].data.pubDate} />
                  </small>
                </div>
                <p class="mt-3 text-gray-500">{posts[0].data.description}</p>
                <span
                  class="mt-5 ml-4 flex items-center justify-center w-30 h-6 rounded-full bg-white text-gray-500 ml-auto"
                >
                  <small class="pl-2">{posts[0].data.duration}</small>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-4 h-4 ml-1 mt--1"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <hr
        class="mt-[clamp(2rem,5vw,4rem)] mb-[clamp(2rem,5vw,4rem)] border-gray-300"
      />
      <div class="flex flex-col sm:flex-row gap-4">
        <div
          class="sm:flex sm:flex-col sm:justify-between sm:flex-[1] sm:max-w-[400px] sm:basis-[80px] sm:shrink-0"
        >
          <h1 class="underline sm:no-underline mb-10 sm:mb-0 text-xl">
            Older posts
          </h1>
          <div class="hidden sm:block sm:flex-[3] mt-10 max-w-xl">
            {allTags.length > 0 ? (
              allTags.map((tag) => (
                  <div class="mb-2">
                    <Tag tag={tag} href={`/blog/${tag}`} size="md" />
                  </div>
                ))
            ) : (
              <p class="text-gray-500">No tags found.</p>
            )}
          </div>
        </div>
        <div class="sm:flex-[3] max-w-xl">
          <ul>
            {
              posts.slice(1).map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}/`}
                    class="p-5 block md:p-10 mb-5 bg-gray-50 rounded-lg hover:bg-gray-200 transition-colors duration-500"
                    <div class="sm:flex sm:items-center sm:justify-between">
                      <h4 class="title text-lg sm:pr-5 md:max-w-[400px]">
                        {post.data.title}
                      </h4>
                      <small class="date flex-full text-gray-500 flex items-center shrink-0">
                        <FormattedDate date={post.data.pubDate} />
                      </small>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
