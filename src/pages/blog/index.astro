---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import '../../styles/global.css';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="font-sans mx-5 md:mx-15">
      <div class="flex flex-col sm:flex-row gap-4 mt-20">
        <div
          class="sm:flex sm:flex-col sm:justify-between sm:flex-[1] sm:max-w-[400px] sm:basis-[80px] sm:shrink-0"
        >
          <h1 class="hidden sm:block text-xl">Latest post</h1>
        </div>
        <div class="sm:flex-[3] max-w-xl">
          <ul>
            <li>
              <a href="#">
                <h4 class="title">Title</h4>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <hr
        class="mt-[clamp(2rem,5vw,4rem)] mb-[clamp(2rem,5vw,4rem)] border-gray-300"
      />
      <div class="flex flex-col sm:flex-row gap-4 mt-20">
        <div
          class="sm:flex sm:flex-col sm:justify-between sm:flex-[1] sm:max-w-[400px] sm:basis-[80px] sm:shrink-0"
        >
          <h1 class="hidden sm:block text-xl">Older posts</h1>
        </div>
        <div class="sm:flex-[3] max-w-xl">
          <ul>
            {
              posts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}/`}
                    class="block p-10 mb-5 bg-gray-50 rounded-lg hover:bg-gray-200 transition-colors duration-500"
                  >
                    <h4 class="title text-lg">{post.data.title}</h4>
                    <p class="date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    <p class="text-gray-500">
                      Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                      Sed id augue rutrum, hendrerit neque non, tristique quam.
                      Pellentesque sed mauris faucibus, sodales enim non,
                      convallis nunc. Phasellus vel orci eu erat vulputate
                      euismod sed at risus.
                    </p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </main>
  </body>
</html>
