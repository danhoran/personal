---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, HEADER_TITLE } from '../consts';
---

<header class="mx-5 md:mx-15 my-5">
  <nav class="flex">
    <h2 class="font-semibold text-md">
      <a href="/">{HEADER_TITLE}</a>
    </h2>
    <div class="ml-auto flex gap-6 items-center">
      <!-- Hamburger button (visible on small screens) -->
      <button
        id="menu-toggle"
        class="block sm:hidden p-2 rounded focus:outline-none hover:cursor-pointer"
        aria-label="Open menu"
        type="button"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <rect y="5" width="24" height="2" rx="1" fill="#6B7280"></rect>
          <rect y="11" width="24" height="2" rx="1" fill="#6B7280"></rect>
          <rect y="17" width="24" height="2" rx="1" fill="#6B7280"></rect>
        </svg>
      </button>
      <!-- Links (hidden on small screens, visible on sm+) -->
      <div class="hidden sm:flex gap-6 items-center">
        <!--
        <HeaderLink
          href="/collections"
          class="text-gray-700 text-lg hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          >Apps</HeaderLink
        >
        <HeaderLink
          href="/thoughts"
          class="text-gray-700 text-lg hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          >Writing</HeaderLink
        >
           -->
        <HeaderLink
          href="/"
          class="text-gray-700 text-lg hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 9.75L12 3l9 6.75M4.5 10.5v9.75A.75.75 0 005.25 21h4.5a.75.75 0 00.75-.75V15a.75.75 0 01.75-.75h2.25A.75.75 0 0114.25 15v5.25c0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75V10.5"
            ></path>
          </svg></HeaderLink
        >
        <HeaderLink
          href="/about"
          class="text-gray-700 text-lg hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          >About</HeaderLink
        >
      </div>
    </div>
    <!-- Mobile menu (hidden by default) -->
    <div
      id="mobile-menu"
      class="sm:hidden fixed top-0 left-0 w-full h-full bg-white bg-opacity-95 z-50 flex-col items-center justify-center gap-8 hidden"
    >
      <button
        id="menu-close"
        class="absolute top-6 right-6 p-2 mx-9 rounded focus:outline-none hover:cursor-pointer"
        aria-label="Close menu"
        type="button"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <line
            x1="6"
            y1="6"
            x2="18"
            y2="18"
            stroke="#6B7280"
            stroke-width="2"
            stroke-linecap="round"></line>
          <line
            x1="6"
            y1="18"
            x2="18"
            y2="6"
            stroke="#6B7280"
            stroke-width="2"
            stroke-linecap="round"></line>
        </svg>
      </button>
      <nav class="flex flex-col items-center gap-8 mt-24">
        <HeaderLink
          href="/"
          class="text-gray-700 text-2xl hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          >Home</HeaderLink
        >
        <!--
        <HeaderLink
          href="/collections"
          class="text-gray-700 text-2xl hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          >Apps</HeaderLink
        >
        <HeaderLink
          href="/thoughts"
          class="text-gray-700 text-2xl hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          >Writing</HeaderLink
        >
      -->
        <HeaderLink
          href="/about"
          class="text-gray-700 text-2xl hover:text-blue-600 transition-colors px-2 py-1 rounded-md"
          >About</HeaderLink
        >
      </nav>
    </div>
    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuClose = document.getElementById('menu-close');

      menuToggle?.addEventListener('click', () => {
        mobileMenu?.classList.remove('hidden');
      });

      menuClose?.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });

      // Optional: close menu on link click (for SPA feel)
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
        });
      });
    </script>
  </nav>
</header>
