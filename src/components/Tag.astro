---
export interface Props {
  tag: string;
  href?: string;
  size?: 'sm' | 'md';
}

const { tag, href, size = 'sm' } = Astro.props;
const sizeClasses = size === 'md' ? 'px-3 py-1 text-md' : 'px-2 py-1 text-xs';
---

{href ? (
  <a 
    href={href}
    class={`inline-block bg-gray-50 hover:bg-gray-200 text-gray-700 rounded-full hover:bg-blue-200 transition-colors duration-200 ${sizeClasses}`}
  >
    {tag.charAt(0).toUpperCase() + tag.slice(1)}
  </a>
) : (
  <span 
    class={`inline-block bg-gray-50 hover:bg-gray-200 rounded-full ${sizeClasses}`}
  >
    {tag.charAt(0).toUpperCase() + tag.slice(1)}
  </span>
)}