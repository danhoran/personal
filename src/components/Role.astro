---
const { title, date, description, achievements } = Astro.props;
---

<li class="mb-10 last:mb-0">
  <h4 class="text-lg">{title}</h4>
  <small class="block mb-5 text-gray-500">{date}</small>
  <p class="text-gray-500">{description}</p>
  {
    achievements && achievements.length > 0 ? () => (
      <div class="mt-5 list-disc p-4 block border rounded-md  border-gray-200">
        <h4 class="text-sm mb-4">In the role...</h4>
        <ul class="list-disc">
        {achievements.map((achievement) => (
          <li class="mb-2 ml-4 text-gray-500 text-xs">{achievement}</li>
        ))}
        </ul>
      </div>
   ) : () => {}
  }
</li>
